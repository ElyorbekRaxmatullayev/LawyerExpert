[Unit]
Description=Bekmuratov Legal Expertise
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/legalexpert
Environment="PATH=/var/www/legalexpert/venv/bin"
EnvironmentFile=-/var/www/legalexpert/.env

ExecStart=/var/www/legalexpert/venv/bin/gunicorn \
    --workers 2 \
    --bind 127.0.0.1:8000 \
    --access-logfile - \
    --error-logfile - \
    wsgi:app

Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
